    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "katex": "0.16.33",
    "mermaid": "11.16.0",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
